{
  "name": "n8n-nodes-invoicerouter",
  "version": "1.6.0",
  "description": "Simplified eight-node n8n Invoice Router for provider-account API setup, simple bulk email lists, auto customer handling, guarded real API sending, and status writeback.",
  "keywords": [
    "n8n",
    "n8n-community-node",
    "n8n-community-node-package",
    "invoice",
    "payments",
    "stripe",
    "lemonsqueezy",
