{
  "name": "n8n-nodes-invoicerouter",
  "version": "1.1.0",
  "description": "Implementation repository for the frozen InvoiceRouter v1.0 eight-node n8n architecture.",
  "keywords": [
    "n8n",
    "n8n-community-node",
    "n8n-community-node-package",
    "invoice",
    "payments",
    "stripe",
    "lemonsqueezy",
    "paddle",
    "polar",
    "automation",
    "typescript",
    "google-sheets",
    "rest-api",
    "community-node"
  ],
  "homepage": "https://github.com/vibtools/n8n-nodes-invoicerouter",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibtools/n8n-nodes-invoicerouter.git"
  },
  "bugs": {
    "url": "https://github.com/vibtools/n8n-nodes-invoicerouter/issues"
  },
  "license": "MIT",
  "author": {
    "name": "InvoiceRouter Contributors"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/vibtools"
  },
  "engines": {
    "node": ">=22.0.0 <25",
    "npm": ">=10.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "VERSION_1_0_FREEZE.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "node --test tests/smoke.test.cjs",
    "dev": "tsc -p tsconfig.json --watch",
    "validate": "node scripts/validate-project.mjs",
    "verify": "npm run validate && npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "n8n-workflow": "^1.100.0"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.100.0"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/InvoiceRouterApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/01_ProviderLoader/Node.node.js",
      "dist/nodes/02_ProviderSelector/Node.node.js",
      "dist/nodes/03_RequestBuilder/Node.node.js",
      "dist/nodes/04_InvoiceSender/Node.node.js",
      "dist/nodes/05_StatusChecker/Node.node.js"
    ],
    "strict": true
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "invoiceRouterFreeze": {
    "architectureVersion": "1.0",
    "status": "FINAL_FREEZE",
    "implementationStatus": "IN_PROGRESS",
    "targetNodeCount": 8,
    "currentBaselineNodeCount": 5,
    "sourceOfTruth": "VERSION_1_0_FREEZE.md"
  }
}
