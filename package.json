    "assets/architecture/invoice-router-architecture-v1.0.png",
    "workflows/InvoiceRouter-v1-production.json",
    "examples/google_sheets/InvoiceRouter_20_Provider_Production_Presets_v1.0.xlsx",
    "docs/freeze/v1.0/N8N_DRY_RUN_VALIDATION.md",
    "docs/freeze/v1.0/PROVIDER_REQUEST_RESPONSE_MAPPING.md",
    "docs/freeze/v1.0/STATUS_WRITEBACK_WIRING.md",
    "docs/freeze/v1.0/RETRY_ERROR_CLASSIFICATION.md",
    "docs/freeze/v1.0/SANDBOX_LIVE_ACTIVATION.md",
    "docs/freeze/v1.0/BULK_RUN_SAFETY.md",
    "docs/freeze/v1.0/PRODUCTION_PRESET_SELF_CHECK_AND_RETRY_WIRING.md",
    "docs/freeze/v1.0/NODE_ICON_CARD_WIRING.md",
    "examples/n8n_dry_run_validation",
    "docs/freeze/v1.0/V1_5_0_BUILD_INSTALL_LIVE_TEST_RUNBOOK.md",
    "docs/freeze/v1.0/N8N_REGISTRY_UI_INSTALL_COMPATIBILITY.md",
    "scripts/diagnose-n8n-package.mjs",
    "docs/freeze/v1.0/V1_6_0_SIMPLE_BULK_EMAIL_WORKFLOW.md",
    "examples/n8n_simple_bulk_email",
    "workflows/InvoiceRouter-v1.6-simple-bulk-email.json"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-node-icons.mjs",
    "test": "node --test tests/smoke.test.cjs",
    "dev": "tsc -p tsconfig.json --watch",
    "validate": "node scripts/validate-project.mjs",
    "verify": "npm run validate && npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm pack --dry-run",
    "prepack": "npm run build",
    "diagnose:n8n-package": "node scripts/diagnose-n8n-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "n8n-workflow": "^1.100.0"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/01_ProviderLoader/ProviderLoader.node.js",
      "dist/nodes/02_ProviderSelector/ProviderSelector.node.js",
      "dist/nodes/03_InvoiceTemplate/InvoiceTemplate.node.js",
      "dist/nodes/04_EmailList/EmailList.node.js",
      "dist/nodes/05_RequestBuilder/RequestBuilder.node.js",
      "dist/nodes/06_InvoiceSender/InvoiceSender.node.js",
      "dist/nodes/07_StatusChecker/StatusChecker.node.js",
      "dist/nodes/08_StatusManager/StatusManager.node.js"
    ],
    "strict": true
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "invoiceRouterFreeze": {
    "architectureVersion": "1.0",
    "status": "FINAL_FREEZE",
    "implementationStatus": "COMPLETE",
    "targetNodeCount": 8,
    "currentNodeCount": 8,
    "sourceOfTruth": "VERSION_1_0_FREEZE.md"
  }
