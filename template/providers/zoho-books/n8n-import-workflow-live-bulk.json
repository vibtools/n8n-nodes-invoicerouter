      "id": "status-writeback-sheet",
      "name": "Google Sheets - Status Writeback",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [
        1120,
        120
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const retryItems = [];\nfor (const item of items) {\n  const management = item.json.management || {};\n  if (management.retryScheduled !== true || !management.retryQueueEntry) continue;\n  const delaySeconds = Math.max(1, Number(management.retryDelaySeconds || management.retryQueueEntry.delaySeconds || 1));\n  retryItems.push({\n    json: {\n      ...item.json,\n      readyRequest: management.retryRequest || item.json.readyRequest,\n      retryCount: Number(management.retryCount || 0),\n      retryDelaySeconds: delaySeconds,\n      retryQueueEntry: management.retryQueueEntry,\n      retryLoop: {\n        enabled: true,\n        source: 'Status Manager',\n        nextRetryCount: Number(management.retryCount || 0),\n        delaySeconds,\n        scheduledAt: management.retryQueueEntry.scheduledAt || '',\n        reason: management.retryQueueEntry.reason || '',\n        lifecycleResume: management.retryResume || management.retryQueueEntry.lifecycleResume || null,\n      },\n    },\n    pairedItem: item.pairedItem,\n  });\n}\nreturn retryItems;"
      },
      "id": "prepare-retry-request",
      "name": "Prepare Retry Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        360
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ Math.max(1, Number($json.retryDelaySeconds || 1)) }}",
        "unit": "seconds"
      },
      "id": "wait-before-retry",
      "name": "Wait Before Retry",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1120,
        360
      ]
    }
  ],
