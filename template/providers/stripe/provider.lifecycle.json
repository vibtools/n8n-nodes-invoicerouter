{
  "schemaVersion": "2.0",
  "providerId": "stripe",
  "recipeId": "stripe-complete-bulk-email",
  "displayName": "Stripe Complete Bulk Invoice Email",
  "runtime": {
    "type": "declarative_http"
  },
  "lifecycleModes": [
    "createOnly",
    "createAndPost",
    "createPostAndSendEmail"
  ],
  "requiredAccountFields": [
    "API Key"
  ],
  "requiredRecipientFields": [
    "Email"
  ],
  "capabilities": {
    "supportsCustomerLookup": false,
    "supportsCustomerCreate": true,
    "supportsInvoiceCreate": true,
    "supportsInvoicePost": true,
    "supportsInvoiceEmailSend": true,
    "supportsInvoicePdf": true
  },
  "notes": [
    "Stripe test mode uses the same API base URL with a sk_test_ secret key.",
    "Stripe API v1 uses form-encoded request bodies. This recipe uses raw application/x-www-form-urlencoded bodies.",
    "Invoice amount is sent in the smallest currency unit via invoice.customFields.stripeAmountCents.",
    "Current template creates a Stripe Customer per new invoice run. For customer reuse, add a persistent Stripe customer ID mapping in a future provider proof/template revision."
  ],
  "steps": [
    {
      "id": "customer.create",
      "lifecycleStep": "customer.create_if_missing",
      "request": {
        "method": "POST",
        "url": "{{request.baseUrl}}/v1/customers",
        "headers": {
          "Authorization": "Bearer {{API_KEY}}",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "bodyEncoding": "raw",
        "body": "email={{recipient.email}}&name={{recipient.name}}&metadata[invoicerouter_request_id]={{request.requestId}}&metadata[invoicerouter_recipient_email]={{recipient.email}}"
      },
      "successStatusCodes": [
        200,
        201
      ],
      "successStatus": "CREATED",
      "responseMap": {
        "providerCustomerId": [
          "id"
        ],
        "customerStatus": [
          "object"
        ]
      },
      "facts": {
        "providerCustomerId": [
          "id"
        ],
        "customerId": [
          "id"
        ]
      }
    },
    {
      "id": "invoice.create",
      "lifecycleStep": "invoice.create",
      "request": {
        "method": "POST",
        "url": "{{request.baseUrl}}/v1/invoices",
        "headers": {
          "Authorization": "Bearer {{API_KEY}}",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "bodyEncoding": "raw",
        "body": "customer={{facts.providerCustomerId}}&collection_method={{invoice.customFields.stripeCollectionMethod}}&days_until_due={{invoice.customFields.stripeDaysUntilDue}}&auto_advance=false&description={{invoice.invoiceNumber}}&metadata[invoicerouter_request_id]={{request.requestId}}&metadata[invoicerouter_invoice_number]={{invoice.invoiceNumber}}&metadata[invoicerouter_recipient_email]={{recipient.email}}"
      },
      "successStatusCodes": [
        200,
        201
      ],
      "responseMap": {
        "providerInvoiceId": [
          "id"
        ],
        "invoiceNumber": [
          "number"
        ],
        "invoiceStatus": [
          "status"
        ],
        "invoiceUrl": [
          "hosted_invoice_url"
        ],
        "pdfUrl": [
          "invoice_pdf"
        ]
      },
      "facts": {
        "providerInvoiceId": [
          "id"
        ],
        "invoiceId": [
          "id"
        ],
        "invoiceNumber": [
          "number"
        ],
        "invoiceUrl": [
          "hosted_invoice_url"
        ],
        "pdfUrl": [
          "invoice_pdf"
        ]
      }
    },
    {
      "id": "invoice_item.create",
      "lifecycleStep": "invoice.create",
      "request": {
        "method": "POST",
        "url": "{{request.baseUrl}}/v1/invoiceitems",
        "headers": {
          "Authorization": "Bearer {{API_KEY}}",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "bodyEncoding": "raw",
        "body": "customer={{facts.providerCustomerId}}&invoice={{facts.providerInvoiceId}}&amount={{invoice.customFields.stripeAmountCents}}&currency={{invoice.customFields.stripeCurrencyLower}}&description={{invoice.invoiceNumber}}"
      },
      "successStatusCodes": [
        200,
        201
      ],
      "responseMap": {
        "providerInvoiceItemId": [
          "id"
        ]
      },
      "facts": {
        "providerInvoiceItemId": [
          "id"
        ]
      }
    },
    {
      "id": "invoice.finalize",
      "lifecycleStep": "invoice.post",
      "onlyWhenLifecycleIncludes": "invoice.post",
      "request": {
        "method": "POST",
        "url": "{{request.baseUrl}}/v1/invoices/{{facts.providerInvoiceId}}/finalize",
        "headers": {
          "Authorization": "Bearer {{API_KEY}}",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "bodyEncoding": "raw",
        "body": "auto_advance=false"
      },
      "successStatusCodes": [
        200,
        201
      ],
      "responseMap": {
        "postStatus": [
          "status"
        ],
        "providerInvoiceId": [
          "id"
        ],
        "invoiceNumber": [
          "number"
        ],
        "invoiceStatus": [
          "status"
        ],
        "invoiceUrl": [
          "hosted_invoice_url"
        ],
        "pdfUrl": [
          "invoice_pdf"
        ]
      },
      "facts": {
        "providerInvoiceId": [
          "id"
        ],
        "invoiceNumber": [
          "number"
        ],
        "invoiceUrl": [
          "hosted_invoice_url"
        ],
        "pdfUrl": [
          "invoice_pdf"
        ]
      }
    },
    {
      "id": "invoice.send_email",
      "lifecycleStep": "invoice.send_email",
      "onlyWhenLifecycleIncludes": "invoice.send_email",
      "request": {
        "method": "POST",
        "url": "{{request.baseUrl}}/v1/invoices/{{facts.providerInvoiceId}}/send",
        "headers": {
          "Authorization": "Bearer {{API_KEY}}",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "bodyEncoding": "raw",
        "body": ""
      },
      "successStatusCodes": [
        200,
        201
      ],
      "responseMap": {
        "emailSendStatus": [
          "status"
        ],
        "providerInvoiceId": [
          "id"
        ],
        "invoiceNumber": [
          "number"
        ],
        "invoiceStatus": [
          "status"
        ],
        "invoiceUrl": [
          "hosted_invoice_url"
        ],
        "pdfUrl": [
          "invoice_pdf"
        ]
      },
      "facts": {
        "providerInvoiceId": [
          "id"
        ],
        "invoiceNumber": [
          "number"
        ],
        "invoiceUrl": [
          "hosted_invoice_url"
        ],
        "pdfUrl": [
          "invoice_pdf"
        ]
      }
    }
  ],
  "responseMap": {
    "providerInvoiceId": [
      "result.id",
      "result.facts.providerInvoiceId",
      "id"
    ],
    "providerCustomerId": [
      "result.customer_id",
      "result.facts.providerCustomerId"
    ],
    "invoiceNumber": [
      "result.facts.invoiceNumber",
      "result.number",
      "number"
    ],
    "invoiceUrl": [
      "result.facts.invoiceUrl",
      "result.invoiceUrl",
      "hosted_invoice_url"
    ],
    "pdfUrl": [
      "result.facts.pdfUrl",
      "result.pdfUrl",
      "invoice_pdf"
    ]
  },
  "errorMap": {
    "message": [
      "error.message",
      "message"
    ],
    "code": [
      "error.code",
      "code"
    ],
    "type": [
      "error.type",
      "type"
    ]
  },
  "supportTier": "tier-2-template-ready-live-proof-required",
  "defaultLifecycleMode": "createPostAndSendEmail",
  "writebackFields": [
    "provider_customer_id",
    "customer_status",
    "post_status",
    "email_send_requested",
    "email_send_status",
    "email_send_method",
    "email_error_message",
    "invoice_url",
    "pdf_url"
  ]
}
