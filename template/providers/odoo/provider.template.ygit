{
  "$schema": "https://schema.vib.tools/invoicerouter/provider-template.schema.json",
  "schemaVersion": "2.0",
  "templateId": "template-001-odoo-complete-bulk-email",
  "providerId": "odoo",
  "displayName": "Odoo Complete Bulk Email Sending System",
  "templateVersion": "2.1.0",
  "invoiceRouterVersion": "2.1.0",
  "supportTier": "tier-1-candidate-live-core-proven-email-proof-required",
  "files": {
    "workbook": "InvoiceRouter_TEMPLATE001_ODOO_COMPLETE_BULK_EMAIL_GOOGLE_SHEETS_TEMPLATE.xlsx",
    "n8nWorkflow": "InvoiceRouter_TEMPLATE001_ODOO_COMPLETE_BULK_EMAIL_N8N_IMPORT.json",
    "provider": "provider.csv",
    "emailList": "email_list.csv",
    "invoiceResults": "invoice_results.csv",
    "lifecycleRecipe": "provider.lifecycle.json",
    "readme": "README.md",
    "quickstart": "QUICKSTART.md",
    "providerSandbox": "provider.sandbox.csv",
    "providerLive": "provider.live.csv",
    "workflowDryRun": "n8n-import-workflow-dry-run.json",
    "workflowSandboxCanary": "n8n-import-workflow-sandbox-canary.json",
    "workflowSandboxBulk": "n8n-import-workflow-sandbox-bulk.json",
    "workflowLiveCanary": "n8n-import-workflow-live-canary.json",
    "workflowLiveBulk": "n8n-import-workflow-live-bulk.json",
    "workbookSandbox": "google-sheets-template-sandbox.xlsx",
    "workbookLive": "google-sheets-template-live.xlsx",
    "retryQueue": "retry_queue.csv",
    "accountReport": "account_report.csv",
    "campaignReport": "campaign_report.csv"
  },
  "sheetContract": {
    "providerSheet": "provider",
    "emailListSheet": "email_list",
    "invoiceResultsSheet": "invoice_results",
    "emailListRequiredColumns": [
      "Email"
    ],
    "emailListOptionalColumns": [
      "Name",
      "Address"
    ]
  },
  "defaultSafetyMode": "dryRunValidation",
  "liveBulkRequires": [
    "SEND_REAL_INVOICES",
    "SEND_BULK_REAL_INVOICES"
  ],
  "notes": "Template assets are public starter files. Live email delivery must be proven in the user's Odoo/n8n environment before production claims.",
  "modeSupport": {
    "sandbox": true,
    "live": true,
    "dryRunDefault": true,
    "liveSafety": "live templates keep InvoiceRouter live confirmation and bulk confirmation tokens explicit"
  }
}
