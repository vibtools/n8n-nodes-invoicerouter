{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": {
    "name": "InvoiceRouter",
    "type": "n8n-community-node",
    "version": "1.0.0",
    "status": "Architecture Locked (MVP)"
  },
  "architecture": {
    "freeze": true,
    "source_of_truth": "docs/",
    "workflow": [
      "ProviderLoader",
      "ProviderSelector",
      "RequestBuilder",
      "InvoiceSender",
      "StatusChecker"
    ]
  },
  "directories": {
    "required": [
      "assets",
      "docs",
      "examples",
      "logs",
      "manifest",
      "nodes",
      "providers",
      "scripts",
      "shared",
      "temp",
      "tests",
      "user-docs"
    ]
  },
  "nodes": {
    "required": [
      "01_ProviderLoader",
      "02_ProviderSelector",
      "03_RequestBuilder",
      "04_InvoiceSender",
      "05_StatusChecker"
    ],
    "required_files": [
      "README.md",
      "index.ts",
      "Node.node.ts",
      "Node.description.ts",
      "Node.execute.ts",
      "Node.types.ts",
      "Node.constants.ts",
      "Node.helpers.ts"
    ]
  },
  "providers": {
    "default": [
      "stripe",
      "lemonsqueezy",
      "paddle",
      "polar"
    ],
    "required_files": [
      "README.md",
      "index.ts",
      "Provider.ts",
      "ProviderPayload.ts",
      "ProviderParser.ts",
      "ProviderValidator.ts",
      "ProviderTypes.ts",
      "ProviderConstants.ts",
      "ProviderHelpers.ts"
    ]
  },
  "shared": {
    "directories": [
      "constants",
      "helpers",
      "interfaces",
      "types",
      "utils"
    ]
  },
  "scripts": {
    "required": [
      "bootstrap.ps1",
      "create-architecture.ps1",
      "install.ps1",
      "clean.ps1",
      "format.ps1",
      "lint.ps1",
      "build.ps1",
      "test.ps1",
      "dev.ps1",
      "doctor.ps1",
      "auto-validator.ps1",
      "auto-fix.ps1",
      "release.ps1",
      "publish.ps1"
    ],
    "fixers_directory": "fixers"
  },
  "documentation": {
    "developer": "docs",
    "user": "user-docs"
  },
  "rules": {
    "architecture_changes_allowed": false,
    "rename_core_directories": false,
    "rename_core_files": false,
    "provider_isolation": true,
    "single_responsibility": true,
    "manifest_driven": true,
    "hardcoded_project_structure": false
  }
}

