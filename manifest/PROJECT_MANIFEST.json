{
  "project": {
    "name": "InvoiceRouter",
    "display_name": "InvoiceRouter",
    "version": "1.1.0",
    "status": "Production-Capable Generic REST Runtime",
    "stage": "Production Candidate",
    "license": "MIT",
    "repository": "https://github.com/vibtools/n8n-nodes-invoicerouter",
    "website": "",
    "description": "Universal Invoice Provider Router & Sender for n8n. Supports multiple invoice providers using a unified workflow and adapter architecture."
  },
  "vision": {
    "goal": "Build one universal invoice automation platform that can connect to multiple invoice providers and send invoices through a common interface.",
    "design_principles": [
      "Simple",
      "Fast",
      "Modular",
      "Reusable",
      "Provider Independent",
      "Scalable",
      "Future Proof"
    ]
  },
  "current_phase": {
    "provider_storage": "Google Sheets",
    "customer_storage": "Google Sheets",
    "invoice_source": "Workflow Input",
    "database": "None",
    "web_panel": false,
    "cache": "Memory Only"
  },
  "future_plan": {
    "provider_storage": "SQLite",
    "customer_storage": "SQLite / PostgreSQL",
    "provider_panel": true,
    "oauth_manager": true,
    "provider_marketplace": true,
    "redis_cache": true,
    "api_server": "FastAPI",
    "docker_support": true
  },
  "workflow": [
    {
      "step": 1,
      "name": "Provider Loader",
      "description": "Load enabled providers from Google Sheets."
    },
    {
      "step": 2,
      "name": "Provider Selector",
      "description": "Assign provider to every customer."
    },
    {
      "step": 3,
      "name": "Request Builder",
      "description": "Build a normalized provider-independent invoice request."
    },
    {
      "step": 4,
      "name": "Invoice Sender",
      "description": "Execute credential-backed create, send, or custom provider REST API requests."
    },
    {
      "step": 5,
      "name": "Status Checker",
      "description": "Check invoice delivery or payment status."
    }
  ],
  "nodes": [
    {
      "id": "provider_loader",
      "folder": "nodes/01_ProviderLoader",
      "status": "Implemented",
      "priority": 1,
      "responsibility": [
        "Connect Google Sheets",
        "Read Providers",
        "Validate Rows",
        "Ignore Disabled Providers",
        "Generate Provider Pool"
      ]
    },
    {
      "id": "provider_selector",
      "folder": "nodes/02_ProviderSelector",
      "status": "Implemented",
      "priority": 2,
      "responsibility": [
        "Receive Provider Pool",
        "Apply Routing Algorithm",
        "Select Provider",
        "Balance Provider Usage"
      ]
    },
    {
      "id": "request_builder",
      "folder": "nodes/03_RequestBuilder",
      "status": "Implemented",
      "priority": 3,
      "responsibility": [
        "Create Universal Invoice Object",
        "Validate Customer Data",
        "Prepare Invoice Payload"
      ]
    },
    {
      "id": "invoice_sender",
      "folder": "nodes/04_InvoiceSender",
      "status": "Implemented",
      "priority": 4,
      "responsibility": [
        "Load secure n8n credential",
        "Execute real provider REST requests",
        "Support create/send/custom operations",
        "Return normalized response",
        "Support safe dry-run plans"
      ]
    },
    {
      "id": "status_checker",
      "folder": "nodes/05_StatusChecker",
      "status": "Implemented",
      "priority": 5,
      "responsibility": [
        "Call provider status endpoint",
        "Normalize provider status",
        "Return invoice URLs and status metadata"
      ]
    }
  ],
  "provider_adapters": {
    "supported": [
      "Stripe",
      "Zoho Invoice",
      "Invoice Ninja",
      "QuickBooks",
      "Xero",
      "ERPNext",
      "Odoo",
      "Custom REST API"
    ],
    "future": [
      "FreshBooks",
      "Square",
      "Paddle",
      "Wave",
      "Chargebee"
    ]
  },
  "provider_sheet": {
    "sheet_name": "Providers",
    "required_columns": [
      "enabled",
      "provider_name",
      "provider_type"
    ],
    "optional_columns": [
      "create_endpoint",
      "send_endpoint",
      "status_endpoint",
      "priority",
      "weight",
      "notes"
    ]
  },
  "customer_sheet": {
    "sheet_name": "Customers",
    "required_columns": [
      "email"
    ],
    "optional_columns": [
      "name",
      "company",
      "currency",
      "language",
      "invoice_template",
      "amount",
      "custom_fields"
    ]
  },
  "shared_modules": [
    "HTTP Client",
    "Response Parser",
    "Error Handler",
    "Retry Manager",
    "Provider Validator",
    "Memory Cache",
    "Logger",
    "Utilities"
  ],
  "routing_algorithms": [
    "Round Robin",
    "Priority",
    "Random",
    "Weight Based",
    "Least Used",
    "Manual"
  ],
  "common_response": {
    "success": "boolean",
    "provider": "string",
    "invoice_id": "string",
    "invoice_number": "string",
    "invoice_url": "string",
    "pdf_url": "string",
    "status": "string",
    "message": "string",
    "raw_response": "object"
  },
  "development_rules": [
    "Keep every node independent.",
    "Never duplicate HTTP logic.",
    "Every provider must use the same interface.",
    "All outputs must follow the common response schema.",
    "Provider adapters must remain isolated.",
    "Support adding new providers without modifying existing adapters.",
    "Optimize for bulk sending.",
    "Design for future database migration."
  ],
  "mvp_scope": [
    "Google Sheets Provider Storage",
    "Google Sheets Customer List",
    "Universal Invoice Object",
    "Provider Routing",
    "Invoice Sending",
    "Standard Response"
  ],
  "excluded_from_mvp": [
    "SQLite",
    "Web Dashboard",
    "OAuth Manager",
    "Redis",
    "Provider Marketplace",
    "Analytics",
    "User Management"
  ],
  "notes": {
    "purpose": "This file is for AI and developer planning only.",
    "runtime": "Planning manifest; API secrets must remain in n8n credentials.",
    "editable": true
  }
}
