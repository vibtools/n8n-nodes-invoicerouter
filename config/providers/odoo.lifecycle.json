{
  "schemaVersion": "2.0",
  "providerId": "odoo",
  "recipeId": "odoo",
  "displayName": "Odoo",
  "lifecycleModes": [
    "draftOnly",
    "createAndPost",
    "createPostAndSendEmail"
  ],
  "requiredAccountFields": [
    "Database",
    "Username",
    "Password",
    "Issuer_Key"
  ],
  "steps": [
    "customer.search_by_email",
    "customer.create_if_missing",
    "invoice.create",
    "invoice.post",
    "invoice.send_email"
  ],
  "compatibility": {
    "supportedOdooMajorVersions": [
      18,
      19
    ],
    "unknownVersionPolicy": "fail_closed"
  }
}
