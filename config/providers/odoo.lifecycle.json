{
  "schemaVersion": "2.0",
  "providerId": "odoo",
  "recipeId": "odoo",
  "displayName": "Odoo",
  "lifecycleModes": [
    "draftOnly",
    "createAndPost",
    "createPostAndSendEmail"
  ],
  "requiredAccountFields": [
    "Database",
    "Username",
    "Password"
  ],
  "steps": [
    "customer.search_by_email",
    "customer.create_if_missing",
    "invoice.create",
    "invoice.post",
    "invoice.send_email"
  ],
  "compatibility": {
    "unknownVersionPolicy": "capability_driven",
    "profiledOdooMajorVersions": [
      18,
      19
    ],
    "versionAllowlistEnforced": false
  },
  "issuerCompatibility": {
    "requiredForFailoverGroups": false,
    "optionalFields": [
      "Issuer_Key"
    ],
    "preflightEvidence": [
      "Company_ID",
      "Company_Name"
    ],
    "mismatchPolicy": "warn_only",
    "blocksProviderSelection": false,
    "blocksInvoiceSending": false
  }
}
